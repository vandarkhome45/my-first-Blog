### 全局变量定义
@baseUrl = http://localhost:8081

#############################################
### 评论系统功能测试
#############################################

### 1. 新增评论
POST {{baseUrl}}/comment?blogId=1
Content-Type: application/json

{
  "content": "这是一篇很好的文章，学到了很多！",
  "author": "张三",
  "email": "zhangsan@example.com"
}

> {% client.global.set("commentId", response.body.data.id); %}

###

#############################################
### 2. 查询某篇博客的所有评论
#############################################
GET {{baseUrl}}/comment/list?blogId=1

###

#############################################
### 3. 根据 ID 查询评论
#############################################
GET {{baseUrl}}/comment/{{commentId}}

###

#############################################
### 4. 回复评论（嵌套评论）
#############################################
POST {{baseUrl}}/comment/reply?parentId={{commentId}}
Content-Type: application/json

{
  "content": "谢谢楼主的分享！",
  "author": "李四",
  "email": "lisi@example.com"
}

###

#############################################
### 5. 查看某条评论的回复列表
#############################################
GET {{baseUrl}}/comment/replies?parentId={{commentId}}

###

#############################################
### 6. 删除评论
#############################################
DELETE {{baseUrl}}/comment/{{commentId}}

###

#############################################
### 7. 批量测试 - 添加多条评论
#############################################

POST {{baseUrl}}/comment?blogId=1
Content-Type: application/json

{
  "content": "第一条评论测试",
  "author": "用户 A",
  "email": "userA@test.com"
}

###

POST {{baseUrl}}/comment?blogId=1
Content-Type: application/json

{
  "content": "第二条评论测试",
  "author": "用户 B",
  "email": "userB@test.com"
}

###

POST {{baseUrl}}/comment?blogId=1
Content-Type: application/json

{
  "content": "第三条评论测试",
  "author": "用户 C",
  "email": "userC@test.com"
}

###

#############################################
### 8. 测试模块禁用功能
#############################################
### 注意：要测试此功能，需要修改 module-config.properties
### 将 module.comment.enabled 改为 false，然后重启服务
### 再次请求评论接口会返回 503 错误

GET {{baseUrl}}/comment/list?blogId=1

###

#############################################
### 9. 完整场景测试
#############################################

### 步骤 1: 先创建一篇新博客
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "测试评论功能的文章",
  "content": "这篇文章用来测试评论系统是否正常工作。"
}

> {% client.global.set("testBlogId", response.body.data.id); %}

###

### 步骤 2: 为这篇博客添加评论
POST {{baseUrl}}/comment?blogId={{testBlogId}}
Content-Type: application/json

{
  "content": "这是第一篇评论！",
  "author": "测试用户",
  "email": "test@example.com"
}

> {% client.global.set("testCommentId", response.body.data.id); %}

###

### 步骤 3: 查看评论列表
GET {{baseUrl}}/comment/list?blogId={{testBlogId}}

###

### 步骤 4: 回复这条评论
POST {{baseUrl}}/comment/reply?parentId={{testCommentId}}
Content-Type: application/json

{
  "content": "这是回复内容",
  "author": "管理员",
  "email": "admin@example.com"
}

###

### 步骤 5: 查看回复列表
GET {{baseUrl}}/comment/replies?parentId={{testCommentId}}

###

### 步骤 6: 删除评论
DELETE {{baseUrl}}/comment/{{testCommentId}}

###
